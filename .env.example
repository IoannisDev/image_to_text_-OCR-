# Copy this file to .env and set the paths for your machine.
# Relative paths are resolved from the project root (the folder holding this file).

CHARSET_PATH=data/charset.json
DBNET_CKPT=model_pt/dbnet_infer.pt
CRNN_CKPT=model_pt/crnn_infer.pt

# 0 is usually the built-in camera; Continuity Camera (iPhone) is often 1
CAMERA_INDEX=1
