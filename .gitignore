# =============================================================================
# color_grade — Deep Learning project
#
# NOTE: Datasets are NOT pushed to GitHub. Keep them locally under data/.
# NOTE: The frontend runs on Streamlit (`streamlit run <app>.py`).
# =============================================================================


# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# -----------------------------------------------------------------------------
# Data (never pushed — too large / licensed, e.g. Places365)
# -----------------------------------------------------------------------------
/data/
/data_raw/
/datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.h5py
*.hdf5
*.npy
*.npz
*.parquet
*.feather
*.tfrecord
*.lmdb


# -----------------------------------------------------------------------------
# Model weights, checkpoints & exports
# (share large weights via Hugging Face / Google Drive / Git LFS instead)
# -----------------------------------------------------------------------------
/model/*
!/model/.gitkeep
!/model/*.py
/models/*
!/models/.gitkeep
checkpoints/
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.onnx
*.safetensors
*.pb
*.tflite
*.joblib
*.pkl


# -----------------------------------------------------------------------------
# Experiment tracking, logs & outputs
# -----------------------------------------------------------------------------
runs/
logs/
*.log
wandb/
mlruns/
lightning_logs/
tb_logs/
outputs/
results/


# -----------------------------------------------------------------------------
# Streamlit (frontend)
# config.toml is fine to commit; secrets are not
# -----------------------------------------------------------------------------
.streamlit/secrets.toml


# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# Packaging
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/


# -----------------------------------------------------------------------------
# Environments & secrets
# -----------------------------------------------------------------------------
.env
.envrc
.venv/
venv/
env/
ENV/
.conda/
.pypirc


# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.py
